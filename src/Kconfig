config ZMK_ESB_ENDPOINT
    bool "ESB endpoint on last BLE profile slot"
    depends on ZMK_BLE
    select NRFX_PPI if HAS_HW_NRF_PPI
    select NRFX_DPPI if HAS_HW_NRF_DPPIC
    select NRFX_TIMER2
    select DYNAMIC_INTERRUPTS
    select DYNAMIC_DIRECT_INTERRUPTS
    select SETTINGS
    help
      Repurposes the last BLE profile slot as an ESB PTX endpoint.
      ESB sources live at vendor/nrf-esb (copied from NCS v3.0.2).
      nrfxlib MPSL is a git submodule at vendor/nrfxlib — run
      `git submodule update --init --recursive` if missing.

if ZMK_ESB_ENDPOINT

config ZMK_ESB_ENDPOINT_LOG_LEVEL
    int "Log level for the zmk-esb-endpoint module"
    default 2
    range 0 4
    help
      Compile-time log level for every TU in this module
      (0=OFF, 1=ERR, 2=WRN, 3=INF, 4=DBG). Independent of
      CONFIG_ZMK_LOG_LEVEL so a developer keeping ZMK at INFO does
      not pay the flash cost of every ESB DBG/INF format string.
      Default 2 (WRN) keeps the field-debuggable warnings/errors and
      drops ~1.4–1.6 KB of DBG/INF strings.

config ZMK_ESB_ENDPOINT_SHELL_CMDS
    bool "Register `esb` shell commands (unpair, channel, bench)"
    depends on SHELL
    default y
    help
      Registers the `esb` root shell command set. Disable on tight
      ROM budgets — the equivalent functionality is also reachable
      via the keymap behaviors (`&esb_unpair`) and the optional
      benchmark/channel-hop diagnostics are not strictly needed
      in production.

config ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY
    bool "Adapt ESB retransmit_count from observed link quality"
    depends on ZMK_ESB_ENDPOINT_CHANNEL_HOP
    default y
    help
      Periodically retunes the ESB retransmit_count based on the EWMA
      of TX attempts: lower on a clean link (lower tail latency),
      higher on a degraded one (better survival). Disabling locks
      retransmit_count at the Kconfig default for the lifetime of the
      slot. Saves ~150–200 B of flash.

config ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY_INTERVAL_MS
    int "Adaptive retry: re-evaluation interval (ms)"
    depends on ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY
    default 25
    range 10 5000
    help
      Cadence at which the adaptive-retry worker recomputes the target
      retransmit_count from the link-quality EWMA. Lower values react
      faster to link changes; higher values reduce workqueue churn.

config ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY_EWMA_LOW
    int "Adaptive retry: lower EWMA breakpoint (attempts × 10)"
    depends on ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY
    default 12
    range 10 100
    help
      Below this EWMA value (in tx_attempts × 10) the link is treated as
      near-perfect — mostly 1-attempt packets — and retransmit_count is
      pinned at COUNT_MIN.

config ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY_EWMA_HIGH
    int "Adaptive retry: upper EWMA breakpoint (attempts × 10)"
    depends on ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY
    default 30
    range 11 200
    help
      At or above this EWMA value (in tx_attempts × 10) the link is
      treated as degraded and retransmit_count is pinned at COUNT_MAX.
      Between LOW and HIGH the count is linearly interpolated, rounded
      toward COUNT_MIN. Must be greater than EWMA_LOW.

config ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY_COUNT_MIN
    int "Adaptive retry: minimum retransmit_count on a clean link"
    depends on ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY
    default 3
    range 0 15
    help
      Floor for the adaptive retransmit_count. Applied when the EWMA is
      at or below ADAPTIVE_RETRY_EWMA_LOW.

config ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY_COUNT_MAX
    int "Adaptive retry: maximum retransmit_count on a degraded link"
    depends on ZMK_ESB_ENDPOINT_ADAPTIVE_RETRY
    default 12
    range 0 15
    help
      Ceiling for the adaptive retransmit_count. Applied when the EWMA
      is at or above ADAPTIVE_RETRY_EWMA_HIGH. Must be ≥ COUNT_MIN.

config ZMK_ESB_ENDPOINT_COOP_HOP
    bool "Cooperative-hop handshake (HOP_OFFER / HOP_ACCEPT)"
    depends on ZMK_ESB_ENDPOINT_CHANNEL_HOP
    default y
    help
      Adds a synchronised channel-hop path that fires earlier than
      the dead-link / weak-link triggers, in the moderately-degraded
      zone where retransmits are climbing but most packets still get
      through. Both sides flip the radio at a co-ordinated deadline
      to minimise the blackout window. Disabling falls back to the
      existing TX-fail-driven and weak-link triggers — coverage
      remains, but coordinated hops on a degraded-but-not-dead link
      no longer happen. Saves ~1.0–1.2 KB of flash.

config ZMK_ESB_ENDPOINT_RENDEZVOUS
    bool "Rendezvous side-trip + cooldown fallback"
    depends on ZMK_ESB_ENDPOINT_CHANNEL_HOP
    default y
    help
      Two recovery paths that re-acquire a desynced dongle by
      reaching the DTS-default rendezvous channel:
      (1) periodic side-trip during the post-hop PROPOSAL burst that
          briefly hops to the rendezvous channel and tells the
          dongle where the keyboard actually is, and
      (2) cooldown fallback that force-hops to the rendezvous
          channel after RENDEZVOUS_FALLBACK_MS of post-hop silence.
      Disabling drops `esb_transport_send_blocking`, the
      synchronous TX state, and both fallback paths — recovery from
      a missed hop then relies entirely on the dongle's own rollback
      dwell cycle. Saves ~550 B of flash.

# BT_LL_SW_SPLIT compile-time reserves PPI channels 6-19, leaving only 0-5
# for application use. ESB needs all 6 of those. Force UART0 to use
# interrupt-driven TX so it does not claim channel 5 at boot.
config UART_0_ENHANCED_POLL_OUT
    default n

