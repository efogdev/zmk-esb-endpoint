config ZMK_ESB_ENDPOINT_SHELL_RELAY
    bool "ESB shell relay (execute commands forwarded from dongle)"
    depends on SHELL
    select SHELL_BACKEND_DUMMY
    default n
    help
      When the dongle requests a shell session (single button press while
      paired), accepts shell commands via ESB and returns output over ESB.
      Commands are executed using the Zephyr dummy shell backend.
      The session ends automatically after SHELL_INACTIVITY_S of no input.

config ZMK_ESB_ENDPOINT_SHELL_POLL_INTERVAL_MS
    int "Shell poll interval (ms)"
    default 50
    range 10 500
    depends on ZMK_ESB_ENDPOINT_SHELL_RELAY
    help
      How often the keyboard sends SHELL_POLL packets to solicit queued
      user input from the dongle when no HID events are occurring.

config ZMK_ESB_ENDPOINT_SHELL_INACTIVITY_S
    int "Shell inactivity timeout (seconds)"
    default 60
    range 0 3600
    depends on ZMK_ESB_ENDPOINT_SHELL_RELAY
    help
      If no command bytes arrive within this period, the keyboard sends
      SHELL_STOP and exits shell relay mode.

config ZMK_ESB_ENDPOINT_SHELL_CMD_BUF_SIZE
    int "Shell command buffer size (bytes)"
    default 256
    depends on ZMK_ESB_ENDPOINT_SHELL_RELAY

config ZMK_ESB_ENDPOINT_SHELL_OUT_BUF_SIZE
    int "Shell output ring buffer size (bytes)"
    default 2048
    depends on ZMK_ESB_ENDPOINT_SHELL_RELAY

config ZMK_ESB_ENDPOINT_SHELL_PROMPT
    string "Shell prompt string"
    default SHELL_PROMPT_UART
    depends on ZMK_ESB_ENDPOINT_SHELL_RELAY

config ZMK_ESB_ENDPOINT_SHELL_BG_POLL
    bool "Send SHELL_BG_POLL keepalives while shell is idle"
    default y
    depends on ZMK_ESB_ENDPOINT_SHELL_RELAY
    help
      When paired but no shell session is active, send periodic
      SHELL_BG_POLL packets to keep the ACK pipeline open so a dongle
      SHELL_REQ is delivered promptly. Disable to avoid any idle-time
      ESB TX; the dongle will then only reach the keyboard via ACKs on
      HID or other ESB traffic the keyboard initiates.

config ZMK_ESB_ENDPOINT_SHELL_BG_POLL_MS
    int "Background ACK poll interval while shell is idle (ms)"
    default 500
    range 100 5000
    depends on ZMK_ESB_ENDPOINT_SHELL_BG_POLL
    help
      How often SHELL_BG_POLL is sent while paired and no shell session
      is active.

config ZMK_ESB_ENDPOINT_SHELL_BG_POLL_ACTIVITY_THRESHOLD_MS
    int "Background ACK poll activity threshold (ms)"
    default 5000
    range 0 3600000
    depends on ZMK_ESB_ENDPOINT_SHELL_BG_POLL
    help
      Gate the background poll on recent ESB traffic: if no non-bg-poll ESB
      TX or RX has occurred within this many milliseconds, the periodic
      SHELL_BG_POLL is suppressed. The work keeps rescheduling so polling
      resumes automatically on the next TX/RX. Set to 0 to disable gating
      (always poll while paired).

config ZMK_ESB_ENDPOINT_SHELL_INITIAL_POLL_DELAY_MS
    int "Initial shell poll delay after SHELL_REQ received (ms)"
    default 20
    range 5 500
    depends on ZMK_ESB_ENDPOINT_SHELL_RELAY

config SHELL_BACKEND_DUMMY_BUF_SIZE
    default 2048 if ZMK_ESB_ENDPOINT_SHELL_RELAY
